[user]
	name = "Ryan Machado"
	email = "me@ryanmac.dev"
	signingkey = /Users/ryangst/.ssh/id_ed25519_sign.pub
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /Users/ryangst/.ssh/allowed_signers
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[merge]
	tool = idea
[mergetool "idea"]
	cmd = idea merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED"
[color]
	ui = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	features = catppuccin-latte
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[includeIf "gitdir:~/Developer/ryangst/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/Developer/tc-rmachado/"]
	path = ~/.gitconfig-work
[includeIf "gitdir:~/.claude/"]
	path = ~/.gitconfig-work
[url "ssh://git@github-work/Twiage/"]
	insteadOf = https://github.com/Twiage/
	insteadOf = git@github.com:Twiage/
